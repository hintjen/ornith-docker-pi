#!/usr/bin/env bash
# Launch the Pi coding agent against the local Laguna server; auto-starts it if needed.
#
#   ./scripts/pi-laguna               # interactive, 32K ctx
#   ./scripts/pi-laguna -p "..."      # headless; any pi args pass through
#
# Same GPU/port as Ornith — if serve-ornith.sh is currently running, stop it first
# (both models need most of a 24GB card; they can't be loaded at the same time).
#
# Env override: ORNITH_NODE_DIR
HERE="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="${ORNITH_NODE_DIR:-$HERE/build/node}/bin:$PATH"

CTX=32768
MODEL=ornith-local/laguna

if ! curl -sf http://localhost:8090/health >/dev/null 2>&1; then
  echo "[pi-laguna] starting server at ${CTX} ctx..." >&2
  LAGUNA_CTX="$CTX" nohup "$HERE/scripts/serve-laguna.sh" "$CTX" >/tmp/laguna-server.log 2>&1 &
  for i in $(seq 1 90); do curl -sf http://localhost:8090/health >/dev/null 2>&1 && break; sleep 2; done
fi

exec pi --model "$MODEL" "$@"
